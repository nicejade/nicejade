<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="675" viewBox="0 0 1200 675" role="img" aria-labelledby="title desc">

    <style>
      @keyframes rise { from {opacity:0} to {opacity:1} }
      @keyframes draw { to {stroke-dashoffset:0} }
      @keyframes breathe { 0%,100%{opacity:.18} 50%{opacity:.34} }
      @keyframes shimmer { 0%{transform:translateX(-130px);opacity:0} 30%{opacity:.18} 70%{opacity:.18} 100%{transform:translateX(520px);opacity:0} }
      @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
      .reveal {opacity:0; animation:rise .85s cubic-bezier(.2,.7,.2,1) forwards}
      .r1{animation-delay:.1s}.r2{animation-delay:.45s}.r3{animation-delay:.8s}
      .chartline{stroke-dasharray:470;stroke-dashoffset:470;animation:draw 2.2s 1.15s cubic-bezier(.2,.7,.2,1) forwards}
      .halo{animation:breathe 4s ease-in-out infinite}
      .float{animation:float 6s ease-in-out infinite}
      .sheen{animation:shimmer 5.5s 1.4s ease-in-out infinite}
    </style>
    
<title id="title">GainMore — Know Your Wealth. Gain More.</title>
<desc id="desc">An animated showcase of private wealth tracking, recurring expenses, goals, action plans and AI guidance.</desc>
<defs>
 <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#080E18"/><stop offset=".55" stop-color="#101B2B"/><stop offset="1" stop-color="#0A1220"/></linearGradient>
 <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#F7DFA0"/><stop offset=".5" stop-color="#D9AD5B"/><stop offset="1" stop-color="#A9772F"/></linearGradient>
 <linearGradient id="goldLine" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#9B743B"/><stop offset=".48" stop-color="#F3D68F"/><stop offset="1" stop-color="#C28E43"/></linearGradient>
 <linearGradient id="card" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#18263A"/><stop offset="1" stop-color="#111D2D"/></linearGradient>
 <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#D9B56C" stop-opacity=".24"/><stop offset="1" stop-color="#D9B56C" stop-opacity="0"/></linearGradient>
 <radialGradient id="orb"><stop stop-color="#D8AD60" stop-opacity=".28"/><stop offset="1" stop-color="#D8AD60" stop-opacity="0"/></radialGradient>
 <filter id="shadow" x="-30%" y="-30%" width="160%" height="170%"><feGaussianBlur stdDeviation="18"/></filter>
 <filter id="soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="10"/></filter>
 <clipPath id="chartClip"><rect x="382" y="288" width="438" height="152" rx="2"/></clipPath>
</defs>
<rect width="1200" height="675" fill="url(#bg)"/>
<circle class="halo" cx="1030" cy="70" r="310" fill="url(#orb)" opacity="0.27"/>
<circle cx="140" cy="560" r="250" fill="#19314A" opacity=".18" filter="url(#soft)"/>
<!-- restrained ambient grid -->
<g opacity=".12" stroke="#7C91A9" stroke-width="1">
 <path d="M40 0V675"/><path d="M120 0V675"/><path d="M200 0V675"/><path d="M280 0V675"/><path d="M360 0V675"/><path d="M440 0V675"/><path d="M520 0V675"/><path d="M600 0V675"/><path d="M680 0V675"/><path d="M760 0V675"/><path d="M840 0V675"/><path d="M920 0V675"/><path d="M1000 0V675"/><path d="M1080 0V675"/><path d="M1160 0V675"/>
 <path d="M0 35H1200"/><path d="M0 115H1200"/><path d="M0 195H1200"/><path d="M0 275H1200"/><path d="M0 355H1200"/><path d="M0 435H1200"/><path d="M0 515H1200"/><path d="M0 595H1200"/>
</g>
<!-- brand header -->
<g class="reveal r1" opacity="1" transform="translate(72 56)">
 <path d="M0 18 L14 0 L28 18 L14 36 Z" fill="none" stroke="url(#gold)" stroke-width="2.3"/>
 <path d="M8 18 L14 10 L20 18 L14 26 Z" fill="url(#gold)"/>
 <text x="42" y="24" fill="#F2F4F7" font-family="Inter,Arial,sans-serif" font-size="21" font-weight="700" letter-spacing="3">GAINMORE</text>
 <text x="43" y="43" fill="#91A0B3" font-family="Inter,Arial,sans-serif" font-size="9" letter-spacing="2.6">PERSONAL WEALTH, WITH CLARITY</text>
</g>
<g class="reveal r2" opacity="1">
 <text x="72" y="151" fill="#F5F1E8" font-family="Inter,Arial,sans-serif" font-size="42" font-weight="650" letter-spacing="-1.4">Know Your Wealth.</text>
 <text x="72" y="202" fill="url(#gold)" font-family="Inter,Arial,sans-serif" font-size="42" font-weight="650" letter-spacing="-1.4">Gain More.</text>
 <text x="74" y="235" fill="#A8B5C6" font-family="Inter,Arial,sans-serif" font-size="15">See the whole picture. Find your next best move.</text>
 <g transform="translate(74 260)">
  <rect width="174" height="29" rx="14.5" fill="#D9B56C" fill-opacity=".12" stroke="#D9B56C" stroke-opacity=".35"/>
  <circle cx="15" cy="14.5" r="3.5" fill="#E7C77E"/>
  <text x="27" y="19" fill="#E8D4A9" font-family="Inter,Arial,sans-serif" font-size="10" letter-spacing=".8">NO BANK CONNECTION</text>
 </g>
</g>
<!-- dashboard shadow and frame -->
<g class="reveal r3" opacity="1" transform="translate(160 0) scale(0.9)">
 <rect x="345" y="92" width="790" height="510" rx="22" fill="#000" opacity=".42" filter="url(#shadow)"/>
 <rect x="332" y="82" width="796" height="512" rx="20" fill="#0D1725" stroke="#40516A" stroke-opacity=".72"/>
 <rect x="333" y="83" width="794" height="44" rx="19" fill="#142236"/>
 <path d="M333 125H1127" stroke="#34465D" opacity=".7"/>
 <circle cx="357" cy="104" r="4" fill="#D26D67"/><circle cx="373" cy="104" r="4" fill="#D8B36B"/><circle cx="389" cy="104" r="4" fill="#6FAE91"/>
 <text x="415" y="108" fill="#9AAABD" font-family="Inter,Arial,sans-serif" font-size="10" letter-spacing="1.2">YOUR WEALTH OVERVIEW</text>
 <text x="1084" y="108" text-anchor="end" fill="#7F91A7" font-family="Inter,Arial,sans-serif" font-size="9">DEMO DATA</text>
 <!-- net worth card -->
 <rect x="360" y="146" width="468" height="324" rx="13" fill="url(#card)" stroke="#34465D" stroke-opacity=".75"/>
 <text x="384" y="179" fill="#A7B4C4" font-family="Inter,Arial,sans-serif" font-size="11" letter-spacing="1.1">NET WORTH</text>
 <text x="384" y="224" fill="#F5F2EB" font-family="Inter,Arial,sans-serif" font-size="36" font-weight="600" letter-spacing="-1">$168,888.68</text>
 <g transform="translate(386 241)">
  <rect width="76" height="23" rx="11.5" fill="#173D35" stroke="#2C6B57"/>
  <path d="M12 15L17 9L22 15" fill="none" stroke="#77C8A0" stroke-width="1.5"/>
  <text x="29" y="16" fill="#87D4AE" font-family="Inter,Arial,sans-serif" font-size="10" font-weight="600">12.36%</text>
 </g>
 <text x="485" y="257" fill="#71839A" font-family="Inter,Arial,sans-serif" font-size="10">vs. previous period</text>
 <!-- chart grid -->
 <g stroke="#34465D" stroke-width="1" opacity=".55">
  <path d="M382 304H806M382 348H806M382 392H806M382 436H806"/>
 </g>
 <g fill="#77889D" font-family="Inter,Arial,sans-serif" font-size="9">
  <text x="382" y="457">JAN</text><text x="482" y="457">MAR</text><text x="582" y="457">MAY</text><text x="682" y="457">JUL</text><text x="786" y="457" text-anchor="end">SEP</text>
 </g>
 <g clip-path="url(#chartClip)">
  <path d="M382 421 C421 411 440 395 474 402 S531 383 562 388 S613 354 646 365 S699 340 730 350 S775 313 818 300 L818 440 L382 440Z" fill="url(#chartFill)" opacity="1.000"/>
  <path class="chartline" d="M382 421 C421 411 440 395 474 402 S531 383 562 388 S613 354 646 365 S699 340 730 350 S775 313 818 300" fill="none" stroke="url(#goldLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="470" stroke-dashoffset="0"/>
 </g>
 <circle cx="810.0" cy="280.0" r="9" fill="#D9B56C" opacity="0.160" filter="url(#soft)"/>
 <circle cx="810.0" cy="280.0" r="4.5" fill="#F4D994" opacity="1.000"/>
 <!-- right column cards -->
 <rect x="846" y="146" width="255" height="148" rx="13" fill="url(#card)" stroke="#34465D" stroke-opacity=".75"/>
 <text x="868" y="177" fill="#A7B4C4" font-family="Inter,Arial,sans-serif" font-size="10" letter-spacing=".8">RECURRING EXPENSES</text>
 <text x="868" y="211" fill="#F2F1EC" font-family="Inter,Arial,sans-serif" font-size="25" font-weight="600">$3,689.78</text>
 <text x="868" y="229" fill="#71839A" font-family="Inter,Arial,sans-serif" font-size="10">annual commitments</text>
 <g transform="translate(868 249)">
  <rect width="206" height="5" rx="2.5" fill="#26384D"/>
  <rect width="106" height="5" rx="2.5" fill="#C99D55"/>
  <rect x="112" width="50" height="5" rx="2.5" fill="#6B89A7"/>
  <rect x="168" width="38" height="5" rx="2.5" fill="#658F82"/>
 </g>
 <g fill="#9AAABD" font-family="Inter,Arial,sans-serif" font-size="9">
  <circle cx="871" cy="275" r="3" fill="#C99D55"/><text x="880" y="278">Housing</text>
  <circle cx="946" cy="275" r="3" fill="#6B89A7"/><text x="955" y="278">Software</text>
  <circle cx="1031" cy="275" r="3" fill="#658F82"/><text x="1040" y="278">Other</text>
 </g>
 <rect x="846" y="310" width="255" height="160" rx="13" fill="url(#card)" stroke="#34465D" stroke-opacity=".75"/>
 <text x="868" y="340" fill="#A7B4C4" font-family="Inter,Arial,sans-serif" font-size="10" letter-spacing=".8">YOUR NEXT GOAL</text>
 <text x="868" y="371" fill="#F2F1EC" font-family="Inter,Arial,sans-serif" font-size="19" font-weight="600">$500K</text>
 <text x="868" y="389" fill="#71839A" font-family="Inter,Arial,sans-serif" font-size="10">Build long-term wealth</text>
 <circle cx="918" cy="432" r="26" fill="none" stroke="#2C3E53" stroke-width="6"/>
 <circle cx="918" cy="432" r="26" fill="none" stroke="url(#goldLine)" stroke-width="6" stroke-linecap="round" stroke-dasharray="60 164" transform="rotate(-90 918 432)"/>
 <text x="918" y="436" text-anchor="middle" fill="#F1D89F" font-family="Inter,Arial,sans-serif" font-size="11" font-weight="600">37%</text>
 <text x="959" y="429" fill="#D9E0E8" font-family="Inter,Arial,sans-serif" font-size="11">On your way</text>
 <text x="959" y="446" fill="#71839A" font-family="Inter,Arial,sans-serif" font-size="9">One step at a time</text>
 <!-- lower AI insight strip -->
 <rect x="360" y="486" width="741" height="84" rx="12" fill="#17283A" stroke="#A77F42" stroke-opacity=".48"/>
 <circle cx="392" cy="527" r="16" fill="#D4AC64" fill-opacity=".14" stroke="#D4AC64" stroke-opacity=".6"/>
 <path d="M392 517V537M382 527H402M385 520L399 534M399 520L385 534" stroke="#E8C77E" stroke-width="1.2" stroke-linecap="round"/>
 <text x="420" y="514" fill="#E9CD91" font-family="Inter,Arial,sans-serif" font-size="10" letter-spacing="1">AI GUIDANCE</text>
 <text x="420" y="537" fill="#E8EDF3" font-family="Inter,Arial,sans-serif" font-size="13">Review 3 recurring expenses to uncover up to</text>
 <text x="420" y="555" fill="#F0D18F" font-family="Inter,Arial,sans-serif" font-size="13" font-weight="600">$120 in potential monthly savings.</text>
 <g transform="translate(1000 518)">
  <rect width="82" height="27" rx="13.5" fill="#D5AD65" fill-opacity=".16" stroke="#D5AD65" stroke-opacity=".55"/>
  <text x="41" y="17.5" text-anchor="middle" fill="#EBD49F" font-family="Inter,Arial,sans-serif" font-size="9" font-weight="600">VIEW PLAN</text>
 </g>
</g>
<!-- bottom value statement -->
<g class="reveal r3" opacity="1">
 <path d="M72 555H280" stroke="#D4AD65" stroke-opacity=".45"/>
 <text x="72" y="583" fill="#E4D1A5" font-family="Inter,Arial,sans-serif" font-size="12" letter-spacing="1.5">CLARITY → ACTION → MORE</text>
 <text x="72" y="608" fill="#8292A7" font-family="Inter,Arial,sans-serif" font-size="10">Your data stays yours. Your decisions stay yours.</text>
 <text x="1128" y="638" text-anchor="end" fill="#66788F" font-family="Inter,Arial,sans-serif" font-size="10" letter-spacing="1.2">GAINMORE.AI</text>
</g>
<!-- animated sheen over product canvas -->
<g opacity="0.2" clip-path="url(#chartClip)">
 <rect class="sheen" x="390" y="280" width="100" height="180" fill="#F7E7BD" opacity=".35" transform="skewX(-18)"/>
</g>
</svg>
